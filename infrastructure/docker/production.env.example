# Copie para ~/infraobserver/.env na VM e preencha. NUNCA versione o .env real.
# Para gerar segredos:  openssl rand -hex 32
# Para gerar um UUID:   cat /proc/sys/kernel/random/uuid

# Domínio público (DNS name do IP público na Azure). O Caddy gera o HTTPS sozinho.
SITE_ADDRESS=infraobserver-bryann.chilecentral.cloudapp.azure.com

# Banco de dados
POSTGRES_DB=infraobserver
POSTGRES_USER=infraobserver
POSTGRES_PASSWORD=troque-por-um-segredo-forte

# Tokens aceitos dos agentes, separados por vírgula.
# Inclua o DEMO_AGENT_TOKEN e um token para cada computador monitorado.
AGENT_TOKENS=token-do-agente-demo,token-do-lab-pc01

# Agente de demonstração que roda no próprio servidor
DEMO_AGENT_TOKEN=token-do-agente-demo
DEMO_AGENT_ID=00000000-0000-4000-8000-000000000000
DEMO_AGENT_HOSTNAME=AZURE-SERVIDOR-01

# Intervalos (segundos)
AGENT_COLLECTION_INTERVAL_SECONDS=60
OFFLINE_CHECK_INTERVAL_SECONDS=60
