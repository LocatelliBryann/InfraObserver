# Endereço do servidor central (backend)
INFRAOBSERVER_SERVER_URL="http://localhost:3000"

# Token de instalação do cliente (ioe_..., gerado no dashboard em Clientes) ou
# um token da lista AGENT_TOKENS do backend. Rodando do código-fonte, a
# credencial recebida na troca não é salva neste arquivo: o agente refaz a
# troca a cada partida (o instalador do Windows salva no agent.env).
INFRAOBSERVER_AGENT_TOKEN="troque-por-um-token-forte"

# Identificador único do endpoint (um UUID por máquina). Se ficar vazio, o
# agente gera um na primeira execução e salva em agent-id, nesta pasta.
INFRAOBSERVER_AGENT_ID=""

# Intervalo de coleta em segundos (padrão: 60)
INFRAOBSERVER_COLLECTION_INTERVAL=60

# Diretórios monitorados, separados por vírgula. Vazio = pastas de cada usuário
# (Área de Trabalho, Documentos, Downloads e Imagens). Para pastas de rede, use o
# caminho UNC (\\servidor\pasta), não a letra da unidade mapeada.
INFRAOBSERVER_MONITORED_DIRECTORIES=""

# Padrões extras de arquivos a ignorar, separados por vírgula (ex.: *.bak,*.log).
# Temporários do Office, navegadores e do Windows já são ignorados.
INFRAOBSERVER_IGNORED_PATTERNS=""

# De quantas em quantas horas o agente instalado no Windows procura uma versão
# nova (padrão: 6). 0 desliga a atualização automática neste computador.
INFRAOBSERVER_UPDATE_INTERVAL_HOURS=6
