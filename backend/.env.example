DATABASE_URL="postgresql://infraobserver:infraobserver_dev@localhost:5432/infraobserver"

# Tokens aceitos dos agentes (separados por vírgula). Cada endpoint pode ter o seu.
AGENT_TOKENS="troque-por-um-token-forte"

# Intervalo de coleta dos agentes, em segundos (deve ser igual ao INFRAOBSERVER_COLLECTION_INTERVAL do agente).
# O endpoint é marcado como OFFLINE após 3 intervalos sem enviar dados.
AGENT_COLLECTION_INTERVAL_SECONDS=60

# Login do dashboard. Em desenvolvimento pode ficar vazio (usa um segredo de teste);
# em produção é obrigatório, com pelo menos 32 caracteres: openssl rand -hex 32
JWT_SECRET=
# Duração da sessão, em horas
SESSION_HOURS=8
# Origens do dashboard que podem chamar a API com o cookie de sessão (desenvolvimento)
CORS_ORIGINS="http://localhost:5173"

# De quanto em quanto tempo o servidor verifica endpoints inativos, em segundos
OFFLINE_CHECK_INTERVAL_SECONDS=60

# Atualização automática dos agentes: a API indica o instalador da última release
# do GitHub. "false" desliga; AGENT_UPDATE_VERSION fixa uma versão (ex.: 1.5.0),
# o que também serve para voltar a uma versão anterior.
AGENT_UPDATES_ENABLED=true
AGENT_UPDATE_VERSION=
AGENT_RELEASES_REPO="LocatelliBryann/InfraObserver"
